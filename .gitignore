# dumper. The processed corpus under corpus/en and corpus/fr IS tracked.
corpus/raw/

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]

# --- Session state --------------------------------------------------------
.claude/scheduled_tasks.lock

# --- Editor and OS noise --------------------------------------------------
.DS_Store
*.swp
*~
.idea/
.vscode/
